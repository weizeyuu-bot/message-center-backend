// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  name         String
  email        String?
  phone        String?
  department   String?
  passwordHash String
  role         String   @default("ROLE_BUYER")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AppRole {
  id             String   @id
  name           String
  description    String?
  permissionJson String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Supplier {
  id           String          @id
  name         String
  taxNumber    String?
  address      String?
  contact      String?
  email        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  priceRecords PriceRecord[]
  orders       PurchaseOrder[]
}

model Material {
  id           String              @id
  name         String
  spec         String?
  unit         String?
  stock        Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  priceRecords PriceRecord[]
  orderItems   PurchaseOrderItem[]
}

model PriceRecord {
  id          String   @id
  supplierId  String
  materialId  String
  unit        String?
  validFrom   DateTime
  validTo     DateTime
  unitPrice   Float
  currency    String   @default("CNY")
  taxRate     Int      @default(13)
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  material    Material @relation(fields: [materialId], references: [id])

  @@index([supplierId])
  @@index([materialId])
}

model PurchaseOrder {
  id                   String              @id
  supplierId           String
  orderDate            DateTime
  status               String
  approvalStatus       String
  approvalStatusText   String?
  approvalStatusState  String?
  processInstanceId    String?             @unique
  processModelId       String?
  processModelName     String?
  createdBy            String?
  creatorRole          String?
  submittedBy          String?
  submittedAt          DateTime?
  currentApprover      String?
  currentApproverRole  String?
  approvedBy           String?
  approvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  items                PurchaseOrderItem[]
  deliveryPlans        DeliveryPlan[]
  invoices             Invoice[]

  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id
  purchaseOrderId String
  lineId          String
  materialId      String
  quantity        Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  material        Material      @relation(fields: [materialId], references: [id])

  @@unique([purchaseOrderId, lineId])
  @@index([materialId])
}

model DeliveryPlan {
  id              String             @id
  planDate        DateTime
  status          String
  purchaseOrderId String
  itemCount       Int                @default(0)
  totalQuantity   Float              @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  items           DeliveryPlanItem[]
  invoices        Invoice[]

  @@index([purchaseOrderId])
}

model DeliveryPlanItem {
  id              String       @id
  deliveryPlanId  String
  lineId          String
  purchaseOrderId String
  quantity        Float
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deliveryPlan    DeliveryPlan @relation(fields: [deliveryPlanId], references: [id])

  @@unique([deliveryPlanId, lineId])
  @@index([purchaseOrderId])
}

model Invoice {
  id              String        @id
  invoiceDate     DateTime
  amount          Float
  status          String
  purchaseOrderId String
  deliveryPlanId  String
  itemCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  deliveryPlan    DeliveryPlan  @relation(fields: [deliveryPlanId], references: [id])
  items           InvoiceItem[]

  @@index([purchaseOrderId])
  @@index([deliveryPlanId])
}

model InvoiceItem {
  id              String   @id
  invoiceId       String
  lineId          String
  purchaseOrderId String
  deliveryPlanId  String
  amount          Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, lineId])
  @@index([purchaseOrderId])
  @@index([deliveryPlanId])
}

model ProcessCategory {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  owner       String?
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  forms       FormConfig[]
}

model FormConfig {
  id          String          @id @default(uuid())
  name        String
  categoryId  String
  schemaJson  String?
  businessObject String?
  initiatorRole String?
  approverRole String?
  status      String          @default("ACTIVE")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    ProcessCategory @relation(fields: [categoryId], references: [id])
  models      ProcessModel[]
}

model ProcessModel {
  id          String       @id @default(uuid())
  name        String
  formId      String
  version     String       @default("v1")
  status      String       @default("DRAFT")
  businessObject String?
  initiatorRole String?
  approverRole String?
  nodeCount    Int         @default(0)
  description  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  form        FormConfig   @relation(fields: [formId], references: [id])
  nodes       ProcessNode[]
  deployments Deployment[]
  instances   ProcessInstance[]
}

model ProcessNode {
  id                String       @id @default(uuid())
  modelId           String
  nodeKey           String
  nodeName          String
  nodeType          String
  nodeAction        String?
  assigneeRole      String?
  nodePolicy        String?
  branchSet         String?
  branchGroup       String?
  branchMergeTo     String?
  conditionField    String?
  conditionOperator String?
  conditionValue    String?
  conditionIsDefault Boolean?
  sla               String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  model             ProcessModel @relation(fields: [modelId], references: [id])

  @@unique([modelId, nodeKey])
}

model Deployment {
  id           String       @id @default(uuid())
  deploymentId String       @unique
  modelId      String
  environment  String
  scope        String?
  deployTime   DateTime?
  publishedBy  String?
  status       String       @default("PUBLISHED")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  model        ProcessModel @relation(fields: [modelId], references: [id])
}

model ProcessInstance {
  id             String       @id
  modelId        String
  businessId     String
  currentNode    String?
  initiator      String?
  initiatorRole  String?
  currentHandler String?
  statusText     String?
  statusState    String?
  submittedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  model          ProcessModel @relation(fields: [modelId], references: [id])
  actionLogs     ApprovalActionLog[]

  @@index([modelId])
}

model ApprovalActionLog {
  id                String          @id @default(uuid())
  processInstanceId String
  businessObject    String
  businessId        String
  action            String
  operator          String?
  operatorRole      String?
  comment           String?
  statusText        String?
  statusState       String?
  createdAt         DateTime        @default(now())
  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)

  @@index([processInstanceId, createdAt])
  @@index([businessObject, businessId, createdAt])
}

// ─── 消息中心新增模型 ────────────────────────────────────────

model DataSource {
  id          String          @id @default(uuid())
  name        String          @unique
  type        String          // POSTGRESQL | MYSQL | MSSQL | ORACLE
  host        String
  port        Int
  database    String
  username    String
  password    String
  schema      String?
  description String?
  status      String          @default("ACTIVE")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  queries     QueryTemplate[]
}

model QueryTemplate {
  id           String         @id @default(uuid())
  name         String
  dataSourceId String
  sql          String
  columnsJson  String?        // JSON array of {field, label, width?}
  messageTemplate String?      // markdown template. supports {{title}} {{rowCount}} {{table}} {{time}}
  description  String?
  status       String         @default("ACTIVE")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  dataSource   DataSource     @relation(fields: [dataSourceId], references: [id])
  tasks        ScheduledTask[]

  @@index([dataSourceId])
}

model NotifyChannel {
  id          String         @id @default(uuid())
  name        String         @unique
  type        String         // EMAIL | DINGTALK | WECOM
  configJson  String         // {smtp:{host,port,secure,user,pass,from}} or {webhook:url} or {webhook:url,secret:...}
  description String?
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tasks       ScheduledTask[]
}

model ScheduledTask {
  id              String         @id @default(uuid())
  name            String         @unique
  cronExpr        String         // e.g. "0 8 * * 1-5"
  queryTemplateId String
  channelId       String
  recipients      String         // comma-separated email addresses or leave empty for webhook-only
  messageTitle    String?
  status          String         @default("ACTIVE") // ACTIVE | PAUSED
  lastRunAt       DateTime?
  lastRunStatus   String?        // SUCCESS | FAILED
  nextRunAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  queryTemplate   QueryTemplate  @relation(fields: [queryTemplateId], references: [id])
  channel         NotifyChannel  @relation(fields: [channelId], references: [id])
  runLogs         TaskRunLog[]

  @@index([queryTemplateId])
  @@index([channelId])
}

model TaskRunLog {
  id          String        @id @default(uuid())
  taskId      String
  status      String        // SUCCESS | FAILED
  rowCount    Int?
  message     String?
  content     String?
  startedAt   DateTime
  finishedAt  DateTime?
  createdAt   DateTime      @default(now())
  task        ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}
